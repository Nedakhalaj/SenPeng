// Secrets.example.xcconfig
// Template for local API keys. Never put real keys in this file.
//
// Setup:
//   1. Copy this file to Config/Secrets.xcconfig (that file is git-ignored).
//   2. Replace the placeholder values with your own keys.

// Trafiklab key for GTFS Regional Realtime, used to look up real arrival times.
// Get one at https://developer.trafiklab.se
TRAFIKLAB_API_KEY = your-trafiklab-key-here
