// Debug.xcconfig
// Settings for local development and tests: fast builds, full debug info.

#include "Shared.xcconfig"

// Local API keys. The file is git-ignored and optional, so the project
// still builds without it. Copy Secrets.example.xcconfig to create it.
#include? "Secrets.xcconfig"

SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG $(inherited)
SWIFT_OPTIMIZATION_LEVEL = -Onone
GCC_OPTIMIZATION_LEVEL = 0
DEBUG_INFORMATION_FORMAT = dwarf
ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES
MTL_ENABLE_DEBUG_INFO = INCLUDE_SOURCE
